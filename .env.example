# MyHOT 설정 파일입니다. .env로 복사해서 고친 뒤 사용하세요 (또는 `node scripts/init-env.ts`를 실행하면 .env가 생성되고 무작위 키까지 채워집니다).
# 프론트엔드는 사이트 주소만 사용하며, 모든 키는 백엔드에서만 다룹니다. .env를 Git에 절대 커밋하지 마세요.

# ===== 필수 =====

# 사이트의 외부 주소: 생성되는 모든 링크, RSS, 공유 이미지, MCP가 이 값을 사용합니다. 로컬 시험에서는 아래 값을 그대로 사용하세요.
SITE_URL=http://localhost:3000

# 관리자 비밀번호(최소 12자). /admin 로그인에 사용합니다.
ADMIN_PASSWORD=

# 세션 서명 및 이미지 프록시 서명 키. 각각 무작위 문자열을 채워주세요 (openssl rand -hex 32로 생성 가능).
SESSION_SECRET=
IMG_PROXY_SIGN_SECRET=

# Docker를 사용할 때 데이터베이스 비밀번호 (외부에 포트를 열지 않더라도, 무작위 문자열을 권장합니다).
POSTGRES_PASSWORD=

# 모델: 어떤 OpenAI 호환 API든 가능합니다. 모든 단계는 기본적으로 이 모델을 사용합니다. 아래는 DeepSeek 예시입니다.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 각 공급자가 받는 추가 파라미터(JSON). 예: 사고(thinking) 모드를 끄기
LLM_EXTRA_JSON={"thinking":{"type":"disabled"}}
# 다른 공급자 예시:
#   Qwen      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen3.8-flash  LLM_EXTRA_JSON={"enable_thinking":false}
#   GLM       LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4               LLM_MODEL=glm-5.3-flash  LLM_EXTRA_JSON={"thinking":{"type":"enabled"},"reasoning_effort":"low"}
# 모델이 이미지를 볼 수 있으면 켜 두세요 (엄선 콘텐츠의 제목·요약이 대표 이미지를 참고합니다):
# LLM_VISION=true
# 서비스가 JSON 모드(response_format)를 지원하지 않으면 끄세요:
# LLM_JSON_MODE=false
# 추론 모델(먼저 생각하고 답하는, 추론과 답이 출력 분량을 공유하는)에 추론용 여유 분량(토큰). 각 단계의 기본 분량에 더해집니다. 비워 두면 0.
# "output token limit reached (finish_reason=length)" 오류가 나면 설정하세요. 예:
# LLM_REASONING_TOKENS=4000

# ===== 선택: 이벤트 묶음을 더 정확하게 =====

# 벡터 호출: 어떤 OpenAI 호환 /embeddings API든 가능합니다. 비워 두어도 동작합니다: 묶음이 텍스트 유사도로 후보를 찾습니다.
# 다만 열람 신호만으로 평가하는 커뮤니티 출처(hot_signal 출처)는 이벤트에 연결되지 못해 열람 수 계산이 낮게 나옵니다.
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# 또는 아리바바 클라우드(유창의 Aliyun Bailian/Alibaba Cloud DashScope) 키만 채워도 text-embedding-v4를 사용합니다:
# DASHSCOPE_API_KEY=
# 벡터 차원 (EMBEDDING_*를 쓰면 기본으로 서비스가 반환하는 값을 사용, Bailian 기본 1024). 변경하면 기존 벡터는 다시 계산됩니다:
# EMBEDDING_DIMS=

# ===== 선택: 각 단계마다 다른 모델을 쓸 때 =====
# 기본적으로 모든 단계는 위의 LLM_*을 사용합니다. 특정 단계에 다른 모델을 쓰고 싶으면 프리셋 이름을 적습니다(라벨마다 대응하는 키 필요):
#   PREFILTER_MODEL  SCORE_MODEL  UNDERSTAND_MODEL  SUMMARIZE_MODEL  WORDING_MODEL  STRUCTURE_MODEL
#   GROUP_MODEL  GROUP_REVIEW_MODEL  DIGEST_MODEL  REPORT_MODEL  TRANSLATE_MODEL
# 프리셋 이름과 대응하는 키:
#   deepseek-flash / deepseek-flash-think        DEEPSEEK_BASE_URL=https://api.deepseek.com/v1  DEEPSEEK_API_KEY=
#   qwen3.7-flash / qwen3.8-flash / qwen3-vl-flash  DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  DASHSCOPE_API_KEY=
#   glm-5.3-flash / glm-5.3-flash-selection     ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4  ZHIPU_API_KEY=
#   mimo-v2.6-flash                             XIAOMI_MIMO_BASE_URL=https://api.xiaomimimo.com/v1  XIAOMI_MIMO_API_KEY=
# 참고: DASHSCOPE_API_KEY를 채우고 EMBEDDING_API_KEY는 비워 두면, 묶음에 Bailian 벡터(text-embedding-v4)를 사용합니다(Bailian 요금이 별도 청구).

# ===== 선택: 유료 수집 서비스 (요청당 과금, 예산 제한 있음. 관리자 “설정”에서 개별 조절) =====
# X(트위터) 계정: SocialData
# SOCIALDATA_API_KEY=
# WeChat 공중계정:极致了(Dajiala)
# DAJIALA_KEY=
# 본문을 가져오지 못할 때 브라우저 렌더링으로 대체: Jina Reader
# JINA_API_KEY=

# ===== 선택: Feishu(飞书, Lark) =====
# T1, T1_5 출처의 엄선 콘텐츠만 Feishu 그룹에 보냅니다: 관리자 “설정 → 알림 대상”에서 활성화하고 webhook 주소는 여기에 적습니다.
FEISHU_CONTENT_PUSH_ENABLED=false
# FEISHU_PUSH_WEBHOOK_URL=
# FEISHU_PUSH_MIRROR_WEBHOOK_URL=
# 장애 알림·피드백을 내부 Feishu 그룹에 전달합니다 (피드백은 자체구축 Feishu 앱 필요):
FEISHU_INTERNAL_ENABLED=false
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_INTERNAL_CHAT_ID=
# FEISHU_ALERT_CHAT_ID=
# 알림을 텍스트만 전송합니다. 한 그룹의 사용자 정의 봇으로도 보낼 수 있습니다: 이 값을 채우면 webhook을 사용하고, 위의 앱·그룹 ID는 쓰지 않습니다(앱 인터페이스 호출량을 아낌).
# FEISHU_ALERT_WEBHOOK_URL=
# 알림을 먼저 여러분의 자동 처리 서비스(예: “깨우기를 지원하는 웹훅 중계 서비스”)에 넘깁니다. 두 값을 모두 채우고 FEISHU_INTERNAL_ENABLED=true일 때만 사용합니다:
# 처리할 알림은 이 주소로 POST합니다 (Authorization: Bearer <KEY>, JSON 필드: id、type、subject、summary、detail、link; 200을 받으면 접수한 것으로 간주, 같은 id가 재전송될 수 있음).
# 사용자 본인에게 보내는 알림·복구 알림·일일 보고는 같은 호스트 루트 아래의 /tell 로 먼저 POST합니다 (JSON 필드: key、text). 접수 못하면 위 Feishu로 대체합니다. 동작은 docs/deploy.md 의 “업데이트” 항목을 참고하세요.
# WEBHOOK_HUB_URL=
# WEBHOOK_HUB_KEY=
# Feishu 계정으로 관리자 페이지를 로그인합니다 (선택, 관리자 비밀번호와 병행):
# FEISHU_LOGIN_APP_ID=
# FEISHU_LOGIN_APP_SECRET=
# ADMIN_FEISHU_UNION_IDS=
# ADMIN_EMAILS=

# ===== 선택: 钉钉(DingTalk, 딩톡) =====
# 엄선 콘텐츠를 딩톡 그룹에 보냅니다 (Feishu 콘텐츠 푸시와 동일한 파이프라인이며, 마찬가지로 T1, T1_5 출처의 엄선만 보냅니다):
# 관리자 “설정 → 알림 대상”에서 “딩톡 콘텐츠 그룹”을 활성화하고 webhook 주소는 여기에 적습니다.
# DINGTALK_CONTENT_PUSH_ENABLED=true
# 딩톡 사용자 정의 봇의 Webhook 주소 (access_token 포함):
# DINGTALK_PUSH_WEBHOOK_URL=
# 봇 보안 설정이 “서명”(加签)인 경우에만 채웁니다 (SEC로 시작). “사용자 정의 키워드” 또는 “IP 화이트리스트”라면 비워 두세요:
# DINGTALK_PUSH_SECRET=

# ===== 선택: 기타 =====
# GitHub API(api.github.com)를 읽는 JSON 출처에 이 값을 붙이면 할당량이 늘어납니다. GitHub는 무료로 신청 가능하며, 읽기 권한만 요청하세요:
# GITHUB_TOKEN=
# 외부 스크립트가 사이트에 콘텐츠를 밀어넣기(POST /api/ingest/items) 위한 토큰(최소 16자). 비워 두면 이 인터페이스는 비활성화됩니다.
# INGEST_TOKEN=
# 밀어넣기 인터페이스의 클라이언트당 분당 최대 호출 수 (docker compose 기본값 10). 앞단의 역방향 프록시가 이미 제한하고 있다면 0으로 설정해도 됩니다:
# INGEST_RATE_LIMIT=10
# 해외 출처를 수집할 때 프록시를 경유해야 하는 경우 (예: 서버가 중국 본토에 있을 때):
# EGRESS_PROXY_URL=http://127.0.0.1:7890
# 출처의 피드나 목록 주소가 내부망에 직접 구축한 서비스 (예: Docker 네트워크의 RSSHub)일 때, 쉼표로 구분해 완전한 호스트명을 적습니다 (대소문자 구분 없음, 와일드카드 미지원).
# 이 주소들만 직접 연결하고 프록시를 경유하지 않습니다. 다른 호스트나 기사 본문·이미지로의 이동에는 내부망 연결이 허용되지 않으며, 링크-로컬 및 클라우드 메타데이터 주소는 항상 거부합니다:
# PRIVATE_FEED_HOSTS=rsshub
# 이미지 프록시가 원본에서 가져오는 트래픽 상한 (분당 MB, 일일 GB). 넘으면 캐시되지 않은 이미지는 먼저 503을 반환합니다. 비워 두면 site/site.ts 의 DEPLOYMENT.imageUpstreamBudget를 따릅니다(기본 비설정):
# IMGPROXY_UPSTREAM_MB_PER_MINUTE=300
# IMGPROXY_UPSTREAM_GB_PER_DAY=30
# 앞에 Caddy 또는 Nginx 같은 역방향 프록시가 있는 경우 true로 설정하고, 방문자 주소는 프록시의 X-Forwarded-For에서 읽습니다.
# 사이트가 직접 외부에 노출되어 있다면 false를 유지하세요. IP를 위장해 로그인 횟수나 피드백 제한을 우회할 수 있습니다.
TRUST_PROXY=false
# MCP는 SITE_URL 도메인(및 localhost)으로 온 요청만 접수합니다. 추가로 허용할 별도 도메인이 있으면 쉼표로 구분해 적으세요:
# MCP_ALLOWED_HOSTS=
# 사이트에 새 콘텐츠가 없으면 “수집 중지”로 보고 경고를 띄웁니다 (분 단위). 비워 두면 site/site.ts 의 ALERTS.quietMinutes (기본 360)를 따릅니다:
# ALERT_QUIET_MINUTES=360
# 매일 새 페이지를 IndexNow(Bing 등)에 제출합니다. key는 32자리 16진수이며, 직접 생성하세요:
INDEXNOW_SUBMIT_ENABLED=false
# INDEXNOW_KEY=
# 매시간 새로 나타난 페이지를 百度(바이두)에 보냅니다. 먼저 百度 검색자원플랫폼에서 사이트를 인증하고, 토큰은 “普通收录 · API提交”의 밀어넣기 주소 끝부분에 있는 문자열입니다:
BAIDU_PUSH_ENABLED=false
# BAIDU_PUSH_TOKEN=
# 데이터베이스를 매일 S3 호환 오브젝트 스토리지(Tencent Cloud COS, AWS S3, 알리바바 클라우드 OSS 등)로 백업합니다.
# DB_BACKUP_STORE_DOMAIN 을 비워 두면 Tencent Cloud COS로 주소를 조합합니다(<버킷명>.cos.<지역>.myqcloud.com).
# 다른 공급자를 쓰는 경우 버킷명이 포함된 액세스 도메인을 채워주세요. 예) AWS S3는 my-bucket.s3.us-east-1.amazonaws.com을 채웁니다:
# DB_BACKUP_STORE_SECRET_ID=
# DB_BACKUP_STORE_SECRET_KEY=
# DB_BACKUP_STORE_BUCKET=
# DB_BACKUP_STORE_REGION=
# DB_BACKUP_STORE_DOMAIN=
# 로그 레벨(기본값 info)과 데이터베이스 커넥션 풀 최대 크기(기본값 10):
# LOG_LEVEL=info
# DATABASE_POOL_MAX=10
# 릴리스 이름: 관리자 “실행” 페이지와 /api/health에 표시됩니다. 업데이트 후 프로세스가 신규 버전으로 교체됐는지 확인할 수 있습니다:
# AIHOT_RELEASE=
# 환경 이름. 기본값은 NODE_ENV에 따라 production 또는 development로 정해집니다. production이 아니면 경고에 이 이름이 포함되며, 개발용 로그인 생략 기능도 production이 아닐 때만 사용할 수 있습니다:
# AIHOT_ENVIRONMENT=
# 키를 그룹별로 한 디렉터리에 작성합니다 (models.env, collectors.env, integrations.env, auth.env). 여기에 적힌 값은 이곳에서 입력한 값보다 우선합니다:
# AIHOT_CREDENTIALS_DIR=

# ===== 안전장치 =====
# true로 작성해야 출처를 수집합니다 (매일 출처 아이콘도 포함). true로 작성해야 모델 호출이 가능합니다. 두 줄을 모두 지우거나 false로 바꾸면 모두 멈춥니다 (디버깅용).
# 이 파일의 모든 *_ENABLED 스위치는 true만 인식하며, 1·yes·TRUE는 모두 꺼짐으로 처리합니다.
COLLECT_ENABLED=true
MODEL_CALLS_ENABLED=true

# ===== Docker 없이 로컬에서 실행할 때만 필요 =====
# DATABASE_URL=postgres://[사용자]@127.0.0.1:5432/myhot
# API_BASE_URL=http://127.0.0.1:3001
# 업로드된 파일, 이미지 캐시, 로컬 백업을 어느 디렉터리에 둘지 (기본값: 저장소 안의 .data):
# AIHOT_DATA_DIR=/var/lib/myhot
# 개발 시 관리자 페이지에 로그인 없이 접속합니다 (프로덕션에서는 시작을 거부합니다). 관리자 화면에 표시되는 이름:
# DEV_AUTH_ROLE=admin
# DEV_AUTH_DISPLAY_NAME=Dev Admin
# 로컬 디버깅용으로 내부망 주소 수집을 허용합니다 (기본은 금지. 프로덕션에서는 시작을 거부합니다):
# ALLOW_PRIVATE_NETWORK_FETCH=true

# ===== docker compose --profile https 로 실행할 때 =====
# SITE_DOMAIN=example.com
# 사이트가 로컬에서 여는 포트 (docker compose, 기본 3000, 모든 인터페이스에서 접속 가능). HTTPS를 쓰는 경우 로컬의 Caddy만 사용하고, 직접 외부에 노출하지 않습니다:
# PORT=127.0.0.1:3000
# 위의 TRUST_PROXY 를 true로 함께 바꿔주세요.
